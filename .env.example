# Copy to .env.local and fill in. Set the same two in Vercel →
# Settings → Environment Variables before launch.
#
# Both values are per-shop: when this site is resold, both change.
# SMS is the only lead channel — there is no email fallback.

# SMS alerts — https://textbelt.com/purchase. Secret; server-side only.
# Use `textbelt_test` to verify wiring without spending a credit.
TEXTBELT_KEY=

# Owner's mobile for lead alerts. Digits only, no +1. Must receive SMS.
NOTIFY_PHONE=
